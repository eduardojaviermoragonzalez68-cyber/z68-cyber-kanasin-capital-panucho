function guardarGestion(){
 const t=document.getElementById('tipo').value;
 const col=document.getElementById('colonia').value;
 const calle=document.getElementById('calle').value;
 const des=document.getElementById('desc').value;
 if(!col){alert('Pon colonia');return;}
 let arr=JSON.parse(localStorage.getItem('gestionesPanucho')||'[]');
 arr.push({tipo:t,colonia:col,calle:calle,desc:des,fecha:new Date().toLocaleString()});
 localStorage.setItem('gestionesPanucho',JSON.stringify(arr));
 alert('Gestión guardada en archivo oculto solo para ti.');
 document.getElementById('colonia').value='';document.getElementById('calle').value='';document.getElementById('desc').value='';
}
function verOculto(){
 const clave=document.getElementById('clave').value;
 if(clave!=='morita2026'){alert('Clave incorrecta, es morita2026');return;}
 const admin=document.getElementById('admin');
 admin.style.display='block';
 let arr=JSON.parse(localStorage.getItem('gestionesPanucho')||'[]');
 if(arr.length==0){admin.innerHTML='No hay gestiones.';return;}
 let html='<b>📁 ARCHIVO OCULTO - SOLO TÚ - PARTICIPACIÓN CIUDADANA:</b><br><br>';
 arr.reverse().forEach((g,i)=>{html+=`<div style="border:1px solid #ffcc00;padding:6px;margin:6px 0;background:#222">${i+1}. ${g.tipo} - ${g.colonia} - ${g.calle}<br>${g.desc}<br><small>${g.fecha}</small></div>`;});
 admin.innerHTML=html;
}
